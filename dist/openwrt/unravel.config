# Each WAN has a named instance. Add its name as option instance in
# every law, output, observability, reflectors and inline reflector section.
#
config instance 'wan'
    option enabled                '1'
    option dry_run                '0'
    option download_interface     'ifb4wan'
    option upload_interface       'wan'
    option download_base_kbits    '50000'
    option download_min_percent   '20'
    option upload_base_kbits      '10000'
    option upload_min_percent     '20'
    # Optional: the highest rate any law may set.
    # option download_max_percent '400'
    # option upload_max_percent   '175'

config law
    option instance               'wan'
    option type                   'sqma'
    option download_delay_ms      '15'
    option upload_delay_ms        '15'
    option high_load_level        '0.8'
    option min_change_interval    '0.5'
    option speed_hist_size        '100'
    option tick_interval          '0.5'

# Experimental: cake-autorate's rate control as a script law. Needs the
# max_percent options in the instance section. Replace the law section above
# with:
#
# config law
#     option instance             'wan'
#     option type                 'script'
#     option path                 '/usr/share/unravel/laws/cake.lua'

config output
    option instance               'wan'
    option log_level              'info'
    # CSV statistics and saved law state go under <folder>/<instance>/.
    option folder                 '/tmp/unravel'
    option suppress_statistics    '0'
    # Send stdout and stderr to the system log.
    option use_syslog             '1'

config observability
    option instance               'wan'
    option enabled                '0'
    option protocol               'udp'
    option host                   '192.168.1.100'
    option port                   '8089'
    option batch_size             '25'
    option batch_timeout_ms       '100'
    option export_ping_metrics    '0'
    option export_rate_metrics    '1'
    option export_law_metrics     '0'
    option export_events          '1'

config reflectors
    option instance               'wan'
    option num_reflectors         '5'

# Anycast reflectors on separate networks. Each ICMP host is listed for
# timestamps and for echo, the fallback when a link drops timestamps.
# Add pool files with list files '/path/to/pool.json'.

config reflector
    option instance               'wan'
    option protocol               'irtt'
    option endpoint               '109.224.229.159:2112'

# Quad9
config reflector
    option instance               'wan'
    option protocol               'icmp-timestamps'
    option endpoint               '9.9.9.9'

config reflector
    option instance               'wan'
    option protocol               'icmp-echo'
    option endpoint               '9.9.9.9'

