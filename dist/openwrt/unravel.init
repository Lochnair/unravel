#!/bin/sh /etc/rc.common
# shellcheck disable=SC2034,SC3043
USE_PROCD=1
START=97
STOP=4

PROG=/usr/sbin/unravel
SERVICE_NAME="unravel"

service_triggers() {
    procd_add_reload_trigger "$SERVICE_NAME"
}

# Prints 1 or 0 for a UCI boolean, or $2 if it is unset or unrecognised.
bool_to_int() {
    case "$1" in
        1|true|yes|y|on|enabled) echo 1 ;;
        0|false|no|n|off|disabled) echo 0 ;;
        *) echo "$2" ;;
    esac
}

# Prints the section part of each section of type $1: the name of a named
# section, `@type[n]` for an anonymous one.
sections_of_type() {
    uci -q show "$SERVICE_NAME" |
        sed -n "s/^${SERVICE_NAME}\.\([^.=]*\)=$1\$/\1/p"
}

# Each network section is an instance. The anonymous one runs without a
# name; each named one runs with --instance <name>.
start_instance() {
    local section="$1"
    local enabled output syslog_out

    # `default` is the unnamed instance's name; unravel rejects it.
    if [ "$section" = default ]; then
        logger -t "$SERVICE_NAME" "network section 'default' is reserved, rename it"
        return 0
    fi

    enabled=$(uci -q get "${SERVICE_NAME}.${section}.enabled")
    [ "$(bool_to_int "$enabled" 1)" = 1 ] || return 0

    # Logging follows the output section the instance uses, resolved the way
    # unravel resolves it: the named one, or for the anonymous instance the
    # anonymous one.
    output=$(uci -q get "${SERVICE_NAME}.${section}.output")
    if [ -z "$output" ]; then
        case "$section" in
            @*) output=$(sections_of_type output | grep '^@' | head -n 1) ;;
        esac
    fi
    syslog_out=
    [ -n "$output" ] &&
        syslog_out=$(uci -q get "${SERVICE_NAME}.${output}.use_syslog")
    syslog_out=$(bool_to_int "$syslog_out" 1)

    case "$section" in
        @*) procd_open_instance default ;;
        *) procd_open_instance "$section" ;;
    esac
    procd_set_param command "$PROG"
    case "$section" in
        @*) ;;
        *) procd_append_param command --instance "$section" ;;
    esac
    procd_set_param respawn
    procd_set_param stdout "$syslog_out"
    procd_set_param stderr "$syslog_out"
    procd_close_instance
}

start_service() {
    local sections section

    sections=$(sections_of_type network)
    # `@network[0]` must not be taken as a glob. The loop cannot be a
    # pipeline: procd keeps the instances in this shell's variables.
    set -f
    for section in $sections; do
        start_instance "$section"
    done
    set +f
}
