#!/bin/sh /etc/rc.common
# shellcheck disable=SC2034,SC3043
USE_PROCD=1
START=97
STOP=4

PROG=/usr/sbin/unravel
SERVICE_NAME="unravel"

service_triggers() {
    procd_add_reload_trigger "$SERVICE_NAME"
}

# Prints 1 or 0 for a UCI boolean, or $2 if it is unset or unrecognised.
bool_to_int() {
    case "$1" in
        1|true|yes|y|on|enabled) echo 1 ;;
        0|false|no|n|off|disabled) echo 0 ;;
        *) echo "$2" ;;
    esac
}

# Prints the section part of each section of type $1: the name of a named
# section, `@type[n]` for an anonymous one.
sections_of_type() {
    uci -q show "$SERVICE_NAME" |
        sed -n "s/^${SERVICE_NAME}\.\([^.=]*\)=$1\$/\1/p"
}

start_instance() {
    local section="$1" outputs="$2"
    local enabled output owner syslog_out

    case "$section" in
        ''|*[!a-zA-Z0-9_]*)
            logger -t "$SERVICE_NAME" "instance section '$section' requires an explicit name"
            return 0
            ;;
    esac

    enabled=$(uci -q get "${SERVICE_NAME}.${section}.enabled")
    [ "$(bool_to_int "$enabled" 1)" = 1 ] || return 0

    for output in $outputs; do
        owner=$(uci -q get "${SERVICE_NAME}.${output}.instance")
        [ "$owner" = "$section" ] || continue
        syslog_out=$(uci -q get "${SERVICE_NAME}.${output}.use_syslog")
        break
    done
    syslog_out=$(bool_to_int "$syslog_out" 1)

    procd_open_instance "$section"
    procd_set_param command "$PROG" --instance "$section"
    procd_set_param respawn
    procd_set_param stdout "$syslog_out"
    procd_set_param stderr "$syslog_out"
    procd_close_instance
}

start_service() {
    local sections outputs section

    sections=$(sections_of_type instance)
    outputs=$(sections_of_type output)
    # Disable globbing for anonymous UCI selectors such as @output[0].
    set -f
    for section in $sections; do
        start_instance "$section" "$outputs"
    done
    set +f
}
